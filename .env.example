# URL base da API do NEXA.
# Em desenvolvimento, use /api/v1 para aproveitar o proxy do Vite (evita CORS).
# Em produção, use a URL completa, por exemplo https://api.nexa.exemplo/api/v1
VITE_API_URL=/api/v1

# true = usa o adaptador mock; false = usa a API real via HTTP
VITE_DEMO_MODE=false

# Nome exibido na interface
VITE_APP_NAME=NEXA

# Intervalo entre tokens do adaptador mock, em milissegundos (padrão: 22)
# Valores baixos aceleram testes; 60 ajuda a observar o streaming e o cancelamento
VITE_MOCK_TOKEN_DELAY=22

# Destino do proxy /api e /health em desenvolvimento (a API sobe em :8000)
VITE_API_PROXY=http://localhost:8000

# Armazenamento do token: 'session' (mantém ao recarregar) ou 'memory' (só em memória)
VITE_AUTH_STORAGE=session

# A API oferece POST /auth/register; o backend também exige ALLOW_SELF_REGISTRATION=true
VITE_REGISTRATION_ENABLED=true

# Ollama local (modo OFFLINE). /ollama usa proxy same-origin no Vite para evitar CORS.
VITE_OLLAMA_URL=/ollama
VITE_OLLAMA_PROXY=http://127.0.0.1:11434
VITE_OLLAMA_NUM_CTX=4096
